rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower()));
    }

    // Friend allowlist: doc ID = lowercase email. Only editable in the Firebase console.
    match /allowed/{email} {
      allow get: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    match /entries/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Free-form posts shown in the feed
    match /posts/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Lists: public lists (shared == false) are readable by everyone on the guest list.
    // Shared watchlists (shared == true) are only visible to, and editable by, their members.
    match /lists/{id} {
      allow read: if isMember()
        && (resource.data.shared == false || request.auth.uid in resource.data.members);
      allow create: if isMember()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isMember()
        && request.resource.data.owner == resource.data.owner
        && (resource.data.owner == request.auth.uid
            || (resource.data.shared == true && request.auth.uid in resource.data.members));
      allow delete: if isMember() && resource.data.owner == request.auth.uid;
    }
  }
}
